# 本地开发模板；生产复制 infra/.env.example 并使用强随机值。
DATAHUB_ENV=development
DATAHUB_SECRET=development-only-change-before-deploying
DATAHUB_DB=sqlite:///./storage/datahub.db
DATAHUB_STORAGE=./storage
DATAHUB_ADMIN_PASSWORD=change-this-local-password
DATAHUB_TOKEN_TTL_SECONDS=28800
DATAHUB_CORS_ORIGINS=http://127.0.0.1:13001
DATAHUB_STORAGE_BACKEND=local
DEEPSEEK_API_KEY=
DATAHUB_EMBEDDING_API_KEY=

# 复制为 .env 后逐项修改。不要把真实 .env 提交到 Git。
DATAHUB_ENV=production
DATAHUB_SECRET=generate-at-least-32-random-characters
DATAHUB_ADMIN_PASSWORD=generate-at-least-12-random-characters
DATAHUB_HTTP_PORT=13001
DATAHUB_TOKEN_TTL_SECONDS=28800
DATAHUB_CORS_ORIGINS=https://datahub.example.com

POSTGRES_DB=datahub
POSTGRES_USER=datahub
POSTGRES_PASSWORD=generate-url-safe-random-password

DATAHUB_STORAGE_BACKEND=s3
DATAHUB_S3_ENDPOINT=http://minio:9000
DATAHUB_S3_BUCKET=datahub
DATAHUB_S3_PREFIX=datahub
DATAHUB_S3_REGION=us-east-1
DATAHUB_S3_ACCESS_KEY=generate-random-access-key
DATAHUB_S3_SECRET_KEY=generate-url-safe-random-secret
DATAHUB_S3_AUTO_CREATE_BUCKET=true
MINIO_ROOT_USER=generate-random-access-key
MINIO_ROOT_PASSWORD=generate-at-least-12-random-characters

DEEPSEEK_API_KEY=
DATAHUB_EMBEDDING_API_KEY=

# 构建时可切换 PyPI 镜像；腾讯云建议使用 https://mirrors.cloud.tencent.com/pypi/simple
PIP_INDEX_URL=https://pypi.org/simple

# 中国网络可改为 minio/mc:latest，或在拉取后打回固定标签
MINIO_MC_IMAGE=minio/mc:RELEASE.2024-11-05T11-29-47Z
